  "narrative": {
    "northStar": "Corporate editorial",
    "overview": "The user-pinned direction pairs a high-impact black opening with white editorial sections, restrained monochrome typography and product-led compositions. Contrast, whitespace and physical work establish confidence. Preserve the official six-bar symbol and wordmark with the approved FZC suffix treatment.",
    "keyCharacteristics": [
      "Monochrome surfaces and graphite text.",
      "Compact display typography with generous editorial space.",
      "Straight controls and softly finished photographic frames.",
      "Sequenced entrances and restrained interactive feedback."
    ],
    "rules": [
      {
        "name": "The Monochrome Rule",
        "body": "Keep the brand interface monochrome; do not introduce decorative colour accents.",
        "section": "colors"
      },
      {
        "name": "The Architectural Edge Rule",
        "body": "Keep layout and controls straight; soften photographs rather than entire sections.",
        "section": "shapes"
      },
      {
        "name": "The Progressive Motion Rule",
        "body": "Reveal content once without making access depend on animation or JavaScript.",
        "section": "components"
      }
    ],
    "dos": [
      "Do preserve the official mark and approved FZC treatment.",
      "Do distinguish product concepts from approved completed work.",
      "Do retain visible keyboard focus and reduced-motion support.",
      "Do use whitespace, typography and photography to establish hierarchy."
    ],
    "donts": [
      "Don't introduce decorative glass, gradients or background grids.",
      "Don't invent clients, results, testimonials or production specifications.",
      "Don't generalize the temporary hero image into a permanent brand requirement."
    ]
